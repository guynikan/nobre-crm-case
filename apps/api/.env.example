# Copy to .env. Never commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nobre_crm
PORT=3333
WEB_ORIGIN=http://localhost:3000
BUSINESS_TIME_ZONE=America/Sao_Paulo
# Freezes "today" so the case data (reference date 15/10/2026) behaves as described. Leave empty to use the real date.
BUSINESS_TODAY=2026-10-15
ATTENTION_THRESHOLD_DAYS=2
FOLLOW_UP_CRON=*/15 * * * *
# Optional: receives a POST with new follow-up reminders.
FOLLOW_UP_WEBHOOK_URL=
# Used only by `pnpm test`; the follow-up integration test wipes this database. Leave empty to skip it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nobre_crm_test
